[gd_resource type="Resource" script_class="MapDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://content/map_definition.gd" id="map"]
[ext_resource type="Script" path="res://content/level_definition.gd" id="level"]
[ext_resource type="Texture2D" path="res://ui/art/dungeon.svg" id="art"]
[ext_resource type="Resource" path="res://content/levels/dungeon_01.tres" id="l1"]
[ext_resource type="Resource" path="res://content/levels/dungeon_02.tres" id="l2"]
[ext_resource type="Resource" path="res://content/levels/dungeon_03.tres" id="l3"]
[ext_resource type="Resource" path="res://content/levels/dungeon_04.tres" id="l4"]
[ext_resource type="Resource" path="res://content/levels/dungeon_05.tres" id="l5"]
[ext_resource type="Resource" path="res://content/levels/dungeon_06.tres" id="l6"]

[resource]
script = ExtResource("map")
id = &"dungeon"
display_name = "Masmorra"
description = "Mistérios de pedra e caminhos secretos."
illustration = ExtResource("art")
accent = Color(0.45098, 0.31765, 0.60392, 1)
levels = Array[ExtResource("level")]([ExtResource("l1"), ExtResource("l2"), ExtResource("l3"), ExtResource("l4"), ExtResource("l5"), ExtResource("l6")])
